  "cards": [
    {
      "dot": "cyan", "title": "Deploy job steps",
      "items": [
        "1. Stop if prod.bicepparam still has '<...>' placeholders",
        "2. azure/login with the OIDC token; GitHub holds four identifiers, no secrets",
        "3. Test-NetworkPrerequisites.ps1, then az deployment group what-if",
        "4. az deployment group create with main.bicep and prod.bicepparam",
        "5. config-zip puts app.zip in the app-package container",
        "6. Smoke test: /api/health reports the commit SHA, and an unauthenticated POST gets 401"
      ]
    },
    {
      "dot": "rose", "title": "What each role allows",
      "items": [
        "Contributor: the workload resource group only",
        "RBAC Administrator: only Storage Blob Data Owner, Storage Table Data Contributor and Monitoring Metrics Publisher, only to service principals",
        "SetEmailCategory Network Join (subnet and NSG read/join) on each subnet; Reader on the VNet. -UseBuiltInNetworkRole grants Network Contributor instead",
        "Private DNS Zone Contributor on the hub zones, if N2 names them"
      ]
    },
    {
      "dot": "amber", "title": "One-time setup",
      "items": [
        "An admin with Owner or User Access Administrator runs Setup-GitHubOidc.ps1",
        "Issuer token.actions.githubusercontent.com; audience api://AzureADTokenExchange",
        "Pull requests run the build job only: the required check on main. Merging deploys nothing"
      ]
    }
  ]
