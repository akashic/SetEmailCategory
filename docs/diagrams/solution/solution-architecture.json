  "cards": [
    {
      "dot": "cyan", "title": "How the function is called",
      "items": [
        "The flow's custom connector calls POST /api/messages/categories with an Entra ID v2.0 token",
        "Easy Auth accepts only tokens issued to the connector app (allowedApplications); anything else gets 401 before code runs",
        "/api/health is excluded from authentication",
        "Each request has a 90 s deadline, under Power Automate's 120 s limit"
      ]
    },
    {
      "dot": "emerald", "title": "Identity and permissions",
      "items": [
        "The function uses its system-assigned managed identity for Graph, storage and telemetry: no secrets",
        "Exchange RBAC for Applications grants Mail.ReadWrite on one shared mailbox; no tenant-wide Graph permission",
        "Storage Blob Data Owner and Storage Table Data Contributor on storage; Monitoring Metrics Publisher on App Insights",
        "At most 4 Graph requests per instance; 429s and 5xx are retried"
      ]
    },
    {
      "dot": "violet", "title": "Networking",
      "items": [
        "Inbound stays public (Power Platform must reach it), protected by Entra ID",
        "All outbound traffic, including Graph, leaves through the app subnet, delegated to Microsoft.App/environments",
        "Storage has public access and shared keys disabled; blob and table are reachable only through private endpoints",
        "The VNet is shared, so the template creates no DNS zones (createPrivateDnsZones = false)"
      ]
    },
    {
      "dot": "amber", "title": "Monitoring and alerts",
      "items": [
        "App Insights ingestion is Entra-authenticated only; Log Analytics keeps 90 days",
        "500/502: any in 15 min. 503: more than 10 in 15 min (Graph throttling)",
        "400/409/413: any in 1 h. Emails go to the ops action group"
      ]
    }
  ]
